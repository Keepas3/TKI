# Supabase connection — required for study posts and puzzle submissions.
# Copy this file to .env.local and fill in your values from the Supabase dashboard
# (Settings → API → Project URL and anon/public key).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Puzzle review page token — only someone who knows this URL can access /puzzle/review/<token>.
# Set it to any random string (e.g. openssl rand -hex 12). Keep this out of the repo.
PUZZLE_REVIEW_TOKEN=your-review-token-here
